{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>okhiroyuki/renovate-config"],
  "forkProcessing": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "description": "sembleバージョン固定を更新する(install-semble.sh の CLI・モデル・MCP 登録と test_install-semble.sh の期待値を同一版に保つ)",
      "managerFilePatterns": [
        "/^scripts/install-semble\\.sh$/",
        "/^scripts/test_install-semble\\.sh$/"
      ],
      "matchStrings": ["semble(?:\\[mcp\\])?==(?<currentValue>[0-9][0-9.]*)"],
      "depNameTemplate": "semble",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "semble の pin 更新を1つのPRにまとめる",
      "matchPackageNames": ["semble"],
      "groupName": "semble"
    }
  ]
}
