  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/validate-commit-message.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/textlint-ai-words.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-status"
  },
  "enabledPlugins": {
    "crit@crit": true,
    "product-skills@claude-code-skills": true,
    "skill-scanner@skillplugs": true,
    "dig@kuu-marketplace": true,
    "fix-ci@kuu-marketplace": true
  },
  "extraKnownMarketplaces": {
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
    "claude-code-skills": {
      "source": {
        "source": "github",
        "repo": "alirezarezvani/claude-skills"
      }
    },
    "skillplugs": {
      "source": {
        "source": "github",
        "repo": "skillplugs/plugins"
      }
    },
    "kuu-marketplace": {
      "source": {
        "source": "github",
        "repo": "fumiya-kume/claude-code"
      }
    }
  },
  "language": "japanese",
  "autoMemoryEnabled": true,
  "theme": "auto",
  "effortLevel": "medium"
}
