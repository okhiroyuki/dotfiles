{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode-go/mimo-v2.5",
  "share": "disabled",
  "instructions": [
    "~/.claude/rules/thinking.md",
    "~/.claude/rules/git.md",
    "~/.claude/rules/llm-wiki.md",
    "~/.claude/rules/security.md",
    "~/.claude/rules/local.md",
    "~/.claude/rules/subagent-delegation.md",
    "~/.claude/rules/zat.md",
    "~/.claude/rules/rtk.md",
    "~/.claude/rules/semble.md",
    "~/.claude/rules/web-access.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "**/.opencode/**": "allow",
      "~/.config/opencode/**": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/**": "deny"
    },
    "skill": "allow",
    "todowrite": "allow",
    "question": "allow",
    "ax": "allow",
    "semble_search": "allow",
    "semble_find_related": "allow",
    "webfetch": "deny",
    "bash": {
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git status": "allow",
      "git log *": "allow",
      "git log": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git diff --no-index*": "deny",
      "git diff*--no-index*": "deny",
      "mise run lint": "allow",
      "git push *": "ask",
      "curl *": "deny",
      "curl": "deny",
      "grep *": "deny",
      "grep": "deny",
      "cat ~/.ssh/*": "deny",
      "rtk read ~/.ssh/*": "deny",
      "cat *.env*": "deny",
      "rtk read *.env*": "deny",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "tree *": "allow",
      "diff *": "allow",
      "jq *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "cut *": "allow",
      "uniq *": "allow",
      "column *": "allow",
      "shasum *": "allow",
      "md5 *": "allow",
      "xxd *": "allow",
      "du *": "allow",
      "df *": "allow",
      "uname *": "allow",
      "whoami": "allow",
      "hostname": "allow",
      "sw_vers *": "allow",
      "uptime": "allow",
      "pbpaste": "allow",
      "git reflog": "allow",
      "git reflog *": "allow",
      "git stash list": "allow",
      "git stash list *": "allow",
      "brew list": "allow",
      "brew list *": "allow",
      "brew outdated": "allow",
      "brew outdated *": "allow",
      "brew deps *": "allow",
      "rtk read *": "allow",
      "rtk ls": "allow",
      "rtk ls *": "allow",
      "rtk tree *": "allow",
      "rtk grep *": "allow",
      "rtk find *": "allow",
      "rtk wc *": "allow",
      "rtk diff *": "allow",
      "rtk json *": "allow",
      "rtk git status": "allow",
      "rtk git status *": "allow",
      "rtk git log": "allow",
      "rtk git log *": "allow",
      "rtk git show *": "allow",
      "rtk git diff": "allow",
      "rtk git diff *": "allow",
      "rtk git blame *": "allow",
      "rtk gh pr list *": "allow",
      "rtk gh pr view *": "allow",
      "rtk gh pr diff *": "allow",
      "rtk gh pr checks *": "allow",
      "rtk gh pr status *": "allow",
      "rtk docker ps": "allow",
      "rtk docker ps *": "allow",
      "rtk docker images": "allow",
      "rtk docker images *": "allow",
      "rtk pytest": "allow",
      "rtk pytest *": "allow",
      "rtk tsc": "allow",
      "rtk tsc *": "allow",
      "rtk ruff check": "allow",
      "rtk ruff check *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "*": "ask"
    }
  }
}
