{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 ~/.cursor/hooks/claude-adapter.py validate-commit-message.py shell",
        "matcher": "git commit",
        "timeout": 10
      },
      {
        "command": "python3 ~/.cursor/hooks/claude-adapter.py confluence-write-guard.py shell",
        "matcher": "confluence",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "python3 ~/.cursor/hooks/claude-adapter.py textlint-ai-words.sh post-write",
        "matcher": "Write",
        "timeout": 30
      }
    ]
  }
}
