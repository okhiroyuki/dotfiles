#!/usr/bin/env python3
"""llm-wiki — LLM-wiki の配管CLI。

保存先(root)をXDG設定に一度決めておけば、任意のcwdから記憶の蓄積(add/log)・
読み込み(search/read)ができる。

中身の執筆・分類・相互リンクの判断は行わない（それはllm-wikiスキル=LLMの担当）。
このCLIは「ファイル配置・_index.md/_log.md更新・検索呼び出し」
という機械的な配管だけを担う。

依存はPython標準ライブラリのみ（3.8+）。semble検索はサブプロセスに委譲する。
semble はファイル変更を自動検知してインデックスを無効化するため、明示的な
再インデックス操作は不要。
"""

import argparse
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# ---- カテゴリ定義 ------------------------------------------------------------
# category(CLI引数) -> (実ディレクトリ名, _index.md のセクション見出し)
CATEGORIES = {
    "decision": ("Decisions", "Decisions"),
    "prd": ("PRDs", "PRDs"),
    "concept": ("Concepts", "Concepts"),
    "research": ("research", "Research"),
    "session": ("sessions", "Sessions"),
}
DATED = {"session"}  # ファイル名を YYYY-MM-DD-<slug>.md にするカテゴリ


def today() -> str:
    return datetime.date.today().isoformat()


def eprint(*args) -> None:
    print(*args, file=sys.stderr)


# ---- 設定(XDG) --------------------------------------------------------------
def config_path() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return Path(base) / "llm-wiki" / "config.toml"


def _toml_escape(s: str) -> str:
    """TOML basic string 用に \\ と " をエスケープする。"""
    return s.replace("\\", "\\\\").replace('"', '\\"')


def _toml_unescape(s: str) -> str:
    """basic string 内の \\ / \" / \\n / \\t を復元する。"""
    out = []
    i = 0
    while i < len(s):
        c = s[i]
        if c == "\\" and i + 1 < len(s):
            nxt = s[i + 1]
            repl = {"\\": "\\", '"': '"', "n": "\n", "t": "\t"}.get(nxt)
            if repl is not None:
                out.append(repl)
                i += 2
                continue
        out.append(c)
        i += 1
    return "".join(out)


def load_config() -> dict:
    """最小TOML(flatな key = "value")を手でパースする。tomllib非依存で3.8+動作。"""
    p = config_path()
    if not p.exists():
        return {}
    cfg = {}
    for line in p.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        val = val.strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
            quote, inner = val[0], val[1:-1]
            # basic string(")のみエスケープを解釈。literal string(')は素通し
            cfg[key.strip()] = _toml_unescape(inner) if quote == '"' else inner
        else:
            cfg[key.strip()] = val
    return cfg


def save_root(path: str) -> Path:
    p = config_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text('root = "%s"\n' % _toml_escape(path), encoding="utf-8")
    return p


def get_root(required: bool = True) -> Path:
    root = load_config().get("root")
    if not root:
        if required:
            eprint("エラー: 保存先(root)が未設定です。`llm-wiki config set-root <path>` で設定してください。")
            sys.exit(2)
        return None
    return Path(os.path.expanduser(root))


def get_wiki_root() -> Path:
    """wiki/ ディレクトリ(=_index.md/_log.md の場所)を返す。"""
    root = get_root()
    wiki = root / "wiki"
    if not wiki.is_dir():
        eprint("エラー: %s が見つかりません。rootが正しいか確認してください。" % wiki)
        sys.exit(2)
    return wiki


# ---- semble 呼び出し ---------------------------------------------------------
def run_semble(args) -> int:
    if shutil.which("semble") is None:
        eprint("警告: semble が見つかりません。検索をスキップしました。")
        return 127
    try:
        return subprocess.run(["semble", *args]).returncode
    except OSError as e:
        eprint("警告: semble の実行に失敗しました: %s" % e)
        return 1


def slugify(text: str) -> str:
    s = text.strip().lower()
    s = re.sub(r"[\s_]+", "-", s)
    s = re.sub(r"[^a-z0-9-]", "", s)
    s = re.sub(r"-+", "-", s).strip("-")
    return s


# ---- _index.md / _log.md 操作 ----------------------------------------------
def next_adr_number(decisions_dir: Path) -> int:
    mx = 0
    if decisions_dir.is_dir():
        for f in decisions_dir.iterdir():
            m = re.match(r"ADR-(\d+)", f.name)
            if m:
                mx = max(mx, int(m.group(1)))
    return mx + 1


def find_section_index(lines: list, section: str):
    """'## <section>' 見出しの行番号を返す。無ければ None。"""
    for i, ln in enumerate(lines):
        if ln.strip() == "## " + section:
            return i
    return None


def insert_index_entry(index_file: Path, section: str, link_path: str, title: str, summary: str) -> None:
    lines = index_file.read_text(encoding="utf-8").splitlines()
    sec_idx = find_section_index(lines, section)
    if sec_idx is None:
        eprint("エラー: _index.md にセクション '## %s' が見つかりません。" % section)
        sys.exit(2)
    # 次の '## ' 見出し(=セクション終端)を探す
    end = len(lines)
    for i in range(sec_idx + 1, len(lines)):
        if lines[i].startswith("## "):
            end = i
            break
    # セクション末尾の空行を除いた挿入位置を求める
    insert_at = end
    while insert_at - 1 > sec_idx and lines[insert_at - 1].strip() == "":
        insert_at -= 1
    entry = "- [%s](%s) — %s" % (title, link_path, summary) if summary else "- [%s](%s)" % (title, link_path)
    # 直前が説明行(空行でもリスト項目でもない)なら、説明行とリストの間に空行を挟む
    prev = lines[insert_at - 1] if insert_at - 1 > sec_idx else ""
    if prev.strip() and not prev.lstrip().startswith("- "):
        lines.insert(insert_at, "")
        insert_at += 1
    lines.insert(insert_at, entry)
    # "Last updated:" を更新
    for i, ln in enumerate(lines):
        if "Last updated:" in ln:
            lines[i] = re.sub(r"Last updated:\s*\d{4}-\d{2}-\d{2}", "Last updated: " + today(), ln)
            break
    index_file.write_text("\n".join(lines) + "\n", encoding="utf-8")


def append_log(log_file: Path, block: str) -> None:
    existing = log_file.read_text(encoding="utf-8") if log_file.exists() else ""
    if existing and not existing.endswith("\n"):
        existing += "\n"
    log_file.write_text(existing + "\n" + block.rstrip("\n") + "\n", encoding="utf-8")


# ---- サブコマンド -----------------------------------------------------------
def cmd_config(args) -> int:
    if args.action == "set-root":
        if not args.path:
            eprint("エラー: set-root には保存先パスを指定してください。例: llm-wiki config set-root ~/Documents/llm-wiki")
            return 2
        path = os.path.abspath(os.path.expanduser(args.path))
        if not (Path(path) / "wiki").is_dir():
            eprint("警告: %s/wiki が存在しません。保存先として設定しますが構造を確認してください。" % path)
        p = save_root(path)
        print("root を設定しました: %s" % path)
        print("設定ファイル: %s" % p)
    elif args.action == "get":
        root = get_root(required=False)
        print(root if root else "(未設定)")
    elif args.action == "path":
        print(config_path())
    return 0


# ---- 完全一致の併用 ----------------------------------------------------------
# semble の BM25 は英数字の識別子しか索引しないため、日本語の短い語（例:「ラック」）は
# 意味検索だけで探すことになり、正解ページが下位に沈む。空白を含まない短いクエリに限り、
# 語をそのまま含むファイルを上位に寄せる。複数語のクエリは語ごとの一致が広く当たり、
# 意味検索の順位を崩すため対象にしない。
DOC_SUFFIXES = {".md", ".markdown"}
LITERAL_MAX_LEN = 20


def literal_query(query: str):
    q = query.strip()
    if not q or len(q) > LITERAL_MAX_LEN or re.search(r"\s", q):
        return None
    return q


def literal_matches(scope_path: Path, needle: str) -> dict:
    """needle を含む文書ファイルを {相対パス: (優先度, 最初の一致行番号, 行)} で返す。

    優先度は ファイル名に一致=2 / 見出し行に一致=1 / 本文のみ=0。大文字小文字は区別しない。
    """
    low = needle.lower()
    found = {}
    for p in sorted(scope_path.rglob("*")):
        if p.suffix.lower() not in DOC_SUFFIXES or not p.is_file():
            continue
        rel = p.relative_to(scope_path)
        # _index.md / _log.md は全ページの語を含むため、一致として数えない
        if is_meta_page(str(rel)) or any(part.startswith(".") for part in rel.parts):
            continue
        try:
            text = p.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if low not in text.lower() and low not in p.stem.lower():
            continue
        first, heading = None, False
        for i, line in enumerate(text.splitlines(), 1):
            if low in line.lower():
                if first is None:
                    first = (i, line)
                if line.lstrip().startswith("#"):
                    heading = True
                    break
        rank = 2 if low in p.stem.lower() else (1 if heading else 0)
        found[rel.as_posix()] = (rank, first or (1, ""))
    return found


def merge_literal(results: list, found: dict, top_k: int, snippet_lines) -> list:
    """語を含む結果を先頭に寄せ、semble が拾わなかった一致ファイルを補う。

    語を含む semble の結果は semble の順位のまま先頭に置く。次に semble が返さなかった
    一致ファイルを優先度順に置き、語を含まない semble の結果をその後ろに回す。
    補ったファイルは score=0.0 とし、match="literal" で区別できるようにする。
    """
    hit, miss = [], []
    for r in results:
        (hit if r.get("file_path") in found else miss).append(r)
    seen = {r["file_path"] for r in hit}
    extra = []
    for rel, (rank, (lineno, line)) in sorted(found.items(), key=lambda kv: -kv[1][0]):
        if rel in seen:
            continue
        extra.append({
            "file_path": rel, "start_line": lineno, "end_line": lineno, "score": 0.0,
            "content": "" if snippet_lines == 0 else line, "match": "literal",
        })
    return (hit + extra + miss)[:top_k]


def _opt_value(extra_args, names, default):
    """semble に渡す追加引数から、指定オプションの値を取り出す（--k=v と --k v の両方）。"""
    val = default
    for i, a in enumerate(extra_args):
        for n in names:
            if a == n and i + 1 < len(extra_args):
                val = extra_args[i + 1]
            elif a.startswith(n + "="):
                val = a.split("=", 1)[1]
    return val


def _strip_opt(extra_args, names):
    """追加引数から、指定オプションとその値を取り除いた列を返す。"""
    out, skip = [], False
    for a in extra_args:
        if skip:
            skip = False
            continue
        if a in names:
            skip = True
            continue
        if any(a.startswith(n + "=") for n in names):
            continue
        out.append(a)
    return out


META_MARGIN = 5


def is_meta_page(file_path: str) -> bool:
    """_index.md / _log.md のような、名前が _ で始まるメタページかを返す。"""
    return any(part.startswith("_") for part in Path(file_path).parts)


def cmd_search(args) -> int:
    root = get_root()
    if args.scope == "root":
        scope_path = root
    else:
        scope_path = root / args.scope
        if not scope_path.is_dir():
            eprint("エラー: 検索範囲 %s が存在しません。root 配下に %s/ ディレクトリが必要です。" % (scope_path, args.scope))
            return 2
    # 既定の範囲は wiki/。raw/ はページ数の多い不変資料のため含めると、
    # 意味の近い wiki ページが raw のマニュアルに押しのけられる（search_eval で実測）。
    semble_args = ["search", args.query, str(scope_path), "--content", "docs", *args.extra_args]
    if _opt_value(args.extra_args, ["--format"], "json") != "json":
        return run_semble(semble_args)
    try:
        top_k = int(_opt_value(args.extra_args, ["-k", "--top-k"], "5"))
        snip = _opt_value(args.extra_args, ["--max-snippet-lines"], None)
        snippet_lines = int(snip) if snip is not None else None
    except ValueError:
        return run_semble(semble_args)
    if shutil.which("semble") is None:
        eprint("警告: semble が見つかりません。検索をスキップしました。")
        return 127
    # _index.md / _log.md は全ページの題名や英語の slug を含み、どの検索語でも上位に来て
    # 本来のページを押し下げる。除いた分を補えるよう、semble には多めに返させる。
    rest = _strip_opt(args.extra_args, ["-k", "--top-k"])
    fetch = ["search", args.query, str(scope_path), "--content", "docs", *rest,
             "--top-k", str(top_k + META_MARGIN)]
    try:
        proc = subprocess.run(["semble", *fetch], stdout=subprocess.PIPE, text=True)
    except OSError as e:
        eprint("警告: semble の実行に失敗しました: %s" % e)
        return 1
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        # 想定外の出力は手を加えずに返す
        sys.stdout.write(proc.stdout)
        return proc.returncode
    results = [r for r in data.get("results", []) if not is_meta_page(r.get("file_path", ""))]
    needle = literal_query(args.query)
    if needle is not None:
        results = merge_literal(results, literal_matches(scope_path, needle), top_k, snippet_lines)
    data["results"] = results[:top_k]
    print(json.dumps(data, ensure_ascii=False))
    return proc.returncode


def cmd_read(args) -> int:
    root = get_root()
    root_resolved = root.resolve()
    rel = Path(args.relpath)
    target = None
    # root起点 → wiki/ 起点の順で解決を試みる。root配下以外（絶対パス・..・
    # symlink経由の逸脱）は絶対に読まない。
    for cand in (root / rel, root / "wiki" / rel):
        if not cand.is_file():
            continue
        resolved = cand.resolve()
        try:
            resolved.relative_to(root_resolved)
        except ValueError:
            eprint("エラー: root配下のパスのみ指定できます: %s" % args.relpath)
            return 2
        target = resolved
        break
    if target is None:
        eprint("エラー: ファイルが見つかりません: %s" % args.relpath)
        return 2
    sys.stdout.write(target.read_text(encoding="utf-8"))
    return 0


def read_body(args) -> str:
    if args.body_file:
        raw = Path(os.path.expanduser(args.body_file))
        # 誤誘導・prompt injection による機密ファイル（~/.ssh 等）の取り込みを
        # 防ぐ。読み込み先は root / カレントディレクトリ / 一時ディレクトリ配下のみ。
        resolved = raw.resolve()
        bases = [Path.cwd().resolve(), Path("/tmp").resolve(), Path(tempfile.gettempdir()).resolve()]
        cfg_root = get_root(required=False)
        if cfg_root:
            bases.append(cfg_root.resolve())
        if not any(resolved == base or base in resolved.parents for base in bases):
            eprint("エラー: --body-file は root・カレントディレクトリ・一時ディレクトリ配下のみ指定できます: %s" % args.body_file)
            sys.exit(2)
        if not raw.is_file():
            eprint("エラー: --body-file が見つかりません: %s" % args.body_file)
            sys.exit(2)
        return raw.read_text(encoding="utf-8").rstrip("\n")
    if args.stdin:
        return sys.stdin.read().rstrip("\n")
    return ""


def format_keywords(raw) -> str:
    """カンマ区切りの英語キーワードを `Keywords: a, b` の 1 行にする。空なら空文字。"""
    if not raw:
        return ""
    words = [w.strip() for w in raw.split(",") if w.strip()]
    return "Keywords: %s" % ", ".join(words) if words else ""


def cmd_add(args) -> int:
    wiki = get_wiki_root()
    dir_name, section = CATEGORIES[args.category]
    target_dir = wiki / dir_name
    target_dir.mkdir(parents=True, exist_ok=True)

    slug = args.slug or slugify(args.title)
    if not slug:
        eprint("エラー: slug を自動生成できませんでした（タイトルが非ASCIIの可能性）。--slug を指定してください。")
        return 2

    # ファイル名の決定
    if args.category == "decision":
        num = next_adr_number(target_dir)
        filename = "ADR-%03d-%s.md" % (num, slug)
    elif args.category in DATED:
        filename = "%s-%s.md" % (today(), slug)
    else:
        filename = "%s.md" % slug

    target = target_dir / filename
    if target.exists():
        eprint("エラー: 既に存在します: %s（上書きしません）" % target)
        return 2

    # ファイルを書き込む前に _index.md のセクション有無を確認しておく。
    # ここで弾かないと、本文だけ作られて index/log 未更新の中途半端な状態になる。
    index_file = wiki / "_index.md"
    index_lines = index_file.read_text(encoding="utf-8").splitlines()
    if find_section_index(index_lines, section) is None:
        eprint("エラー: _index.md にセクション '## %s' が見つかりません。ページは作成していません。" % section)
        return 2

    body = read_body(args)
    link_path = "%s/%s" % (dir_name, filename)

    # --status は decision の frontmatter 用。他カテゴリでは無視する旨を伝える
    if args.status is not None and args.category != "decision":
        eprint("警告: --status は decision 以外では無視されます。")
    status = args.status or "draft"

    # 英語のキーワード行。semble の BM25 は英数字しか索引しないため、日本語のページにも
    # 英語の語を置いて英語の検索語で当たるようにする。見出しの直後に置く。
    head = "# %s\n\n" % args.title
    keywords = format_keywords(args.keywords)
    if keywords:
        head += keywords + "\n\n"

    # frontmatter は Decisions のみ（SKILL.md仕様）
    if args.category == "decision":
        fm = "---\ndate: %s\nstatus: %s\ntags: []\nmodels_considered: []\n---\n\n" % (today(), status)
        content = fm + head + "%s\n" % body
    else:
        content = head + "%s\n" % body

    if args.dry_run:
        print("[dry-run] 実際には書き込みません。次を行う予定です:")
        print("  作成: wiki/%s" % link_path)
        print("  _index.md: '## %s' セクションにエントリを追加、Last updated を更新" % section)
        print("  _log.md: add ログを追記")
        return 0

    target.write_text(content, encoding="utf-8")
    insert_index_entry(index_file, section, link_path, args.title, args.summary or "")

    log_file = wiki / "_log.md"
    log_block = "## [%s] add | %s\n- wiki/%s を新規作成\n- _index.md の %s セクションにエントリを追加、Last updated を %s に更新" % (
        today(), args.title, link_path, section, today(),
    )
    append_log(log_file, log_block)

    print("作成しました: wiki/%s" % link_path)
    print("_index.md / _log.md を更新しました。")
    return 0


def cmd_log(args) -> int:
    wiki = get_wiki_root()
    log_file = wiki / "_log.md"
    block = "## [%s] %s" % (today(), args.message)
    append_log(log_file, block)
    print("_log.md に追記しました。")
    return 0


def first_heading(path: Path) -> str:
    """ファイル先頭の '# 見出し' を返す。無ければ空文字。"""
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            s = line.strip()
            if s.startswith("# "):
                return s[2:].strip()
    except OSError:
        pass
    return ""


def cmd_list(args) -> int:
    wiki = get_wiki_root()
    cats = [args.category] if args.category else list(CATEGORIES.keys())
    printed = False
    for cat in cats:
        dir_name, section = CATEGORIES[cat]
        d = wiki / dir_name
        if not d.is_dir():
            continue
        files = sorted(f for f in d.iterdir() if f.is_file() and f.suffix == ".md")
        if not files:
            continue
        if printed:
            print()
        printed = True
        print("## %s" % section)
        for f in files:
            rel = "%s/%s" % (dir_name, f.name)
            title = first_heading(f)
            print("- %s — %s" % (rel, title) if title else "- %s" % rel)
    if not printed:
        print("(ページがありません)")
    return 0


# ---- パーサ -----------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="llm-wiki", description="LLM-wiki の配管CLI（保存先設定・蓄積・読み込み・再インデックス）")
    sub = p.add_subparsers(dest="cmd", required=True)

    pc = sub.add_parser("config", help="保存先(root)の設定・確認")
    pc.add_argument("action", choices=["set-root", "get", "path"])
    pc.add_argument("path", nargs="?", help="set-root のときの保存先パス")
    pc.set_defaults(func=cmd_config)

    ps = sub.add_parser("search", help="semble で意味検索する（任意のcwdから。既定の範囲は wiki/）")
    ps.add_argument("query")
    ps.add_argument("--scope", choices=["wiki", "raw", "root"], default="wiki",
                    help="検索範囲。wiki（既定）/ raw（raw/ の不変資料）/ root（全体）。query より前に指定する")
    ps.add_argument("extra_args", nargs=argparse.REMAINDER, help="semble search に渡す追加引数")
    ps.set_defaults(func=cmd_search)

    pr = sub.add_parser("read", help="root配下のページを表示する")
    pr.add_argument("relpath")
    pr.set_defaults(func=cmd_read)

    pls = sub.add_parser("list", help="カテゴリ別にページを一覧する")
    pls.add_argument("--category", choices=list(CATEGORIES.keys()), help="指定カテゴリのみ一覧する")
    pls.set_defaults(func=cmd_list)

    pa = sub.add_parser("add", help="ページを新規作成し index/log 更新・再インデックスまで行う")
    pa.add_argument("--category", required=True, choices=list(CATEGORIES.keys()))
    pa.add_argument("--title", required=True)
    pa.add_argument("--summary", default="", help="_index.md の1行要約")
    pa.add_argument("--slug", help="ファイル名のslug（省略時はtitleから自動生成、非ASCIIなら必須）")
    pa.add_argument("--keywords", help="英語のキーワード（カンマ区切り）。見出し直後に `Keywords:` 行として入れる")
    pa.add_argument("--status", help="decision の frontmatter status（既定: draft。例: accepted）")
    body_src = pa.add_mutually_exclusive_group()
    body_src.add_argument("--body-file", help="本文を読み込むファイル")
    body_src.add_argument("--stdin", action="store_true", help="本文を標準入力から読む")
    pa.add_argument("--dry-run", action="store_true", help="書き込まず、実行内容だけ表示する")
    pa.set_defaults(func=cmd_add)

    pl = sub.add_parser("log", help="_log.md に1行追記する")
    pl.add_argument("message", help='例: "add | ○○を記録"')
    pl.set_defaults(func=cmd_log)

    return p


def main() -> int:
    args = build_parser().parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
