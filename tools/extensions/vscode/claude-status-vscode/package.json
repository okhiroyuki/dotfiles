{
  "name": "claude-status-vscode",
  "displayName": "Claude Status",
  "description": "Show the Claude Code session cost/context usage in the VS Code status bar",
  "version": "0.0.5",
  "private": true,
  "engines": {
    "vscode": "1.134.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/vscode": "1.125.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
