# Unix
alias ..="cd .."
alias mkdir="mkdir -p"

# rtk: LLM token-optimized proxies
# https://github.com/rtk-ai/rtk
if builtin command -v rtk > /dev/null; then
  alias ls="rtk ls"
  alias ll="rtk ls -l"
  alias la="rtk ls -la"
  alias cat="rtk read"
  alias grep="rtk grep"
fi

# tig status
# brew install tig
if builtin command -v tig > /dev/null; then
  alias gs="tig status"
else
  alias gs='git status'
fi

# Pretty print the path
alias path='echo $PATH | tr -s ":" "\n"'

# Include custom aliases
if [[ -f ~/.aliases.local ]]; then
  source ~/.aliases.local
fi
