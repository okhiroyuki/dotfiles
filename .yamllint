---
extends: default
# 生成物はlint対象外（yamllint . でnode_modules等を拾わないように）
ignore: |
  **/node_modules/**
  **/pnpm-lock.yaml
  **/pnpm-workspace.yaml
  # git worktree の作業コピー (.claude/worktrees/) は別ブランチの複製なので対象外
  .claude/worktrees/**
rules:
  line-length:
    max: 140
    level: warning
  comments:
    min-spaces-from-content: 1
  # dict/prh.yml は prh の js-yaml が --- （ドキュメント区切り）を読めないため付けていない。
  # document-start ルールのみ免除し、他のルールは検査する
  document-start:
    ignore: |
      tools/textlint/dict/prh.yml
